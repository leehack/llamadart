  "documentation_contract": {
    "workflow": {
      "path": ".github/workflows/sync_native_bindings.yml",
      "input": "native_tag",
      "required_text": "description: 'vM.m.p; numbers max 18 digits; vM.m.p-N, bNNNN[-N], legacy bNNNN-llamadart.N explicit; latest unsuffixed v only'"
    },
    "docs": {
      "AGENTS.md": [
        "at most 18 digits"
      ],
      "README.md": [
        "vMAJOR.MINOR.PATCH",
        "bNNNN",
        "bNNNN-N",
        "bNNNN-llamadart.N",
        "without leading zeros",
        "start at 1",
        "at most 18 digits"
      ],
      "website/docs/getting-started/installation.md": [
        "vMAJOR.MINOR.PATCH",
        "bNNNN",
        "bNNNN-N",
        "bNNNN-llamadart.N",
        "without leading zeros",
        "start at 1",
        "at most 18 digits"
      ],
      "website/docs/platforms/support-matrix.md": [
        "vMAJOR.MINOR.PATCH",
        "bNNNN",
        "bNNNN-N",
        "bNNNN-llamadart.N",
        "reject leading zeros",
        "at most 18 digits"
      ],
      "website/docs/maintainers/native-and-web-sync.md": [
        "`vMAJOR.MINOR.PATCH`",
        "`bNNNN`",
        "`bNNNN-N`",
        "`bNNNN-llamadart.N`",
        "`b0`",
        "without leading zeros",
        "start at 1",
        "at most 18 digits",
        "`latest` accepts only an unsuffixed `vMAJOR.MINOR.PATCH`"
      ]
    }
  },
  "patterns": {
    "stable_pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})$",
    "stable_wrapper_pattern": "^v(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})\\.(0|[1-9][0-9]{0,17})-([1-9][0-9]{0,17})$",
    "nightly_pattern": "^b(0|[1-9][0-9]{0,17})$",
    "nightly_wrapper_pattern": "^b(0|[1-9][0-9]{0,17})-([1-9][0-9]{0,17})$",
    "legacy_wrapper_pattern": "^b(0|[1-9][0-9]{0,17})-llamadart\\.([1-9][0-9]{0,17})$",
    "combined_pattern": "^(?:v(?:0|[1-9][0-9]{0,17})\\.(?:0|[1-9][0-9]{0,17})\\.(?:0|[1-9][0-9]{0,17})(?:-[1-9][0-9]{0,17})?|b(?:0|[1-9][0-9]{0,17})(?:-[1-9][0-9]{0,17}|-llamadart\\.[1-9][0-9]{0,17})?)$",
    "doc_tag_pattern": "(?:v(?:0|[1-9][0-9]{0,17})\\.(?:0|[1-9][0-9]{0,17})\\.(?:0|[1-9][0-9]{0,17})(?:-[1-9][0-9]{0,17})?|b(?:0|[1-9][0-9]{0,17})(?:-[1-9][0-9]{0,17}|-llamadart\\.[1-9][0-9]{0,17})?)"
  },
